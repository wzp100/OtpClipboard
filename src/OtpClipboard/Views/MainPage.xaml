<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="OtpClipboard.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="20,16" />
        </Style>
        <!-- 仿 Windows 设置页的设置卡片：图标 | 标题与说明 | 控件。 -->
        <Style x:Key="SettingCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="68" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="1,20,0,6" />
        </Style>
        <Style x:Key="DescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="4,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingToggleStyle" TargetType="ToggleSwitch">
            <!-- ToggleSwitch 即使 MinWidth=0、内容为空，测量宽度仍是 154，且开关贴左，
                 会离卡片右缘很远。固定宽度 52（轨道 40 + 间隔列 12，不裁切），
                 右边距 -8 抵消轨道右侧空白，使轨道与卡片中的按钮右缘对齐（实测）。 -->
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Margin" Value="0,0,-8,0" />
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="StatusStates">
                <VisualState x:Name="StatusNeutral">
                    <VisualState.Setters>
                        <Setter Target="StatusBadge.Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
                        <Setter Target="StatusGlyph.Foreground" Value="{ThemeResource SystemFillColorAttentionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StatusSuccess">
                    <VisualState.Setters>
                        <Setter Target="StatusBadge.Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
                        <Setter Target="StatusGlyph.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="StatusCaution">
                    <VisualState.Setters>
                        <Setter Target="StatusBadge.Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                        <Setter Target="StatusGlyph.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="Tabs" Margin="16,0,16,0" SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem x:Name="OverviewTab" Text="概览" IsSelected="True">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE80F;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="HistoryTab" Text="记录">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE81C;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="SettingsTab" Text="设置">
                <SelectorBarItem.Icon><FontIcon Glyph="&#xE713;" /></SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <!-- 概览：当前状态、最近验证码、手机连接 -->
        <ScrollViewer x:Name="OverviewPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,12,24,24" Spacing="12">
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="StatusBadge" Width="48" Height="48" CornerRadius="24" VerticalAlignment="Top"
                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                            <FontIcon x:Name="StatusGlyph" Glyph="&#xE946;" FontSize="22"
                                      Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Name="StatusTitle" Text="正在检查通知权限" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="StatusMessage" Text="首次使用请授权通知访问。" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                <Button x:Name="AuthorizeButton" Style="{StaticResource AccentButtonStyle}" Click="AuthorizeButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8D7;" FontSize="16" />
                                        <TextBlock Text="授权通知访问" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MonitorButton" Click="MonitorButton_Click" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="MonitorGlyph" Glyph="&#xE768;" FontSize="16" />
                                        <TextBlock x:Name="MonitorLabel" Text="开始监听" />
                                    </StackPanel>
                                </Button>
                                <Button Click="ScanButton_Click" ToolTipService.ToolTip="处理通知中心里已有、尚未处理过的通知">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                        <TextBlock Text="扫描通知中心" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="最近的验证码" Style="{StaticResource DescriptionStyle}" />
                            <TextBlock x:Name="LatestCode" Text="——" FontSize="34" FontWeight="SemiBold"
                                       CharacterSpacing="120" IsTextSelectionEnabled="True" />
                            <TextBlock x:Name="LatestCodeDetail" Text="还没有识别到验证码。收到后会自动复制，并在输入光标旁提示。"
                                       Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>
                        <Button x:Name="LatestCopyButton" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False"
                                Click="LatestCopyButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                                <TextBlock Text="再次复制" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8EA;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="PhoneLinkStatus" Text="手机连接 · 尚未检查" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="PhoneLinkDetail" Text="应用运行状态不代表手机已连接；请在手机连接内确认蓝牙和通知共享。"
                                       Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="RefreshPhoneButton" Content="检测" Click="RefreshPhoneButton_Click" />
                            <Button x:Name="OpenPhoneButton" Content="打开手机连接" Click="OpenPhoneButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="工作方式" Style="{StaticResource SectionHeaderStyle}" Margin="1,8,0,0" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="1  手机收到短信" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="“手机连接”把通知同步到 Windows 通知中心。" Style="{StaticResource DescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="2  自动识别并复制" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="识别到验证码后立即写入剪贴板。" Style="{StaticResource DescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="3  点击提示填入" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="点输入光标旁的提示直接填入，或按 Ctrl+V。" Style="{StaticResource DescriptionStyle}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="所有处理都在本机完成，不联网。" Style="{StaticResource DescriptionStyle}" Margin="1,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- 记录：处理历史 -->
        <Grid x:Name="HistoryPanel" Grid.Row="1" Padding="24,12,24,16" RowSpacing="12" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RecordSummary" Style="{StaticResource DescriptionStyle}" VerticalAlignment="Center" />
                <ComboBox x:Name="RecordFilter" Grid.Column="1" SelectedIndex="0" MinWidth="130"
                          SelectionChanged="RecordFilter_SelectionChanged">
                    <ComboBoxItem Content="全部记录" />
                    <ComboBoxItem Content="只看已复制" />
                    <ComboBoxItem Content="只看未匹配" />
                    <ComboBoxItem Content="只看已过滤" />
                    <ComboBoxItem Content="只看失败" />
                </ComboBox>
                <Button Grid.Column="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                        <TextBlock Text="清空" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="ClearFlyout">
                            <StackPanel Spacing="12" MaxWidth="260">
                                <TextBlock Text="删除全部记录？" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="记录中保存的验证码也会一并删除，无法恢复。" Style="{StaticResource DescriptionStyle}" />
                                <Button Content="清空记录" Style="{StaticResource AccentButtonStyle}" Click="ClearButton_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <ListView x:Name="EventList" Grid.Row="1" SelectionMode="None" Margin="-12,0,-12,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding StatusBrush}" CornerRadius="4" Padding="8,2" MinWidth="56"
                                    VerticalAlignment="Top" Margin="0,1,0,0">
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="White" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="复制" VerticalAlignment="Top"
                                    Visibility="{Binding CopyVisibility}" Click="CopyRecordButton_Click" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyHistory" Grid.Row="1" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE81C;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyHistoryText" Text="还没有记录" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBlock Grid.Row="2" Style="{StaticResource DescriptionStyle}"
                       Text="最近 200 条记录仅保存处理状态与时间，不保存通知正文或验证码。" />
        </Grid>

        <!-- 设置 -->
        <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Padding="24,0,24,24" Spacing="4">
                <TextBlock Text="识别" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8EA;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="只识别“手机连接”的通知" />
                            <TextBlock Text="关闭后会检查所有应用的通知，可能把其他应用里的数字当成验证码。" Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="PhoneLinkOnlyToggle" Grid.Column="2" IsOn="True"
                                      Style="{StaticResource SettingToggleStyle}" Toggled="Preference_Toggled" />
                    </Grid>
                </Border>

                <TextBlock Text="悬浮提示" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE765;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="收到验证码时显示悬浮提示" />
                            <TextBlock Text="在输入光标旁显示 8 秒，点一下即可填入；找不到光标时显示在鼠标旁。关闭后仅复制到剪贴板。"
                                       Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="PopupToggle" Grid.Column="2" IsOn="True"
                                      Style="{StaticResource SettingToggleStyle}" Toggled="Preference_Toggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE890;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="预览悬浮提示" />
                            <TextBlock Text="用示例 246810 查看效果，不会复制或填入。部分管理员窗口和特殊输入框需要手动 Ctrl+V。"
                                       Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="预览" VerticalAlignment="Center" Click="PreviewPopup_Click"
                                AutomationProperties.Name="预览悬浮提示（示例 246810）" />
                    </Grid>
                </Border>

                <TextBlock Text="后台运行" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE73F;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="关闭或最小化时收起到托盘" />
                            <TextBlock Text="继续在后台监听；点击托盘图标或按 Ctrl+Alt+O 重新打开。关闭后，关闭窗口即退出。"
                                       Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="TrayToggle" Grid.Column="2" IsOn="True"
                                      Style="{StaticResource SettingToggleStyle}" Toggled="Preference_Toggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="登录 Windows 后自动启动" />
                            <TextBlock x:Name="StartupDetail" Style="{StaticResource DescriptionStyle}" />
                            <HyperlinkButton Content="打开系统启动应用设置" Padding="0" Margin="0,2,0,0" FontSize="12"
                                             Click="StartupSettings_Click" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupToggle" Grid.Column="2"
                                      Style="{StaticResource SettingToggleStyle}" Toggled="StartupToggle_Toggled" />
                    </Grid>
                </Border>

                <TextBlock Text="程序" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE737;" Style="{StaticResource SettingIconStyle}" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="窗口" />
                            <TextBlock Text="收起后仍在后台监听；退出后新验证码不会再自动复制。" Style="{StaticResource DescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="收起到托盘" Click="TrayButton_Click" />
                            <Button Content="退出程序" Click="ExitButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Margin="1,16,0,0" Style="{StaticResource DescriptionStyle}"
                           Text="通知内容只在本机处理，不联网。后台依靠系统通知事件工作，不做定时扫描。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
